{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron-cleanup",
      "schedule": "0 3 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap.xml/",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-ads.xml",
      "destination": "/api/sitemap?mode=ads"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/sitemap?mode=index"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?mode=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?mode=llms-full"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?mode=feed"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/seo?mode=feed"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([gG]ooglebot|[gG]oogle-[eE]xtended|[gG]oogle-[iI]nspection[tT]ool|[gG]oogle[oO]ther|[sS]torebot-[gG]oogle|[aA]ds[bB]ot-[gG]oogle|[bB]ingbot|[yY]andex|[dD]uck[dD]uck[bB]ot|[bB]aiduspider|[oO][aA][iI]-[sS]earch[bB]ot|[cC]hat[gG][pP][tT]-[uU]ser|[gG][pP][tT][bB]ot|[pP]erplexity[bB]ot|[pP]erplexity-[uU]ser|[cC]laude[bB]ot|[cC]laude-[wW]eb|[aA]nthropic-[aA][iI]|[aA]pplebot|[fF]acebookexternalhit|[tT]elegram[bB]ot|[wW]hats[aA]pp|[tT]witter[bB]ot|[lL]inked[iI]n[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/seo?mode=html"
    },
    {
      "source": "/ad/:adRef",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([gG]ooglebot|[gG]oogle-[eE]xtended|[gG]oogle-[iI]nspection[tT]ool|[gG]oogle[oO]ther|[sS]torebot-[gG]oogle|[aA]ds[bB]ot-[gG]oogle|[bB]ingbot|[yY]andex|[dD]uck[dD]uck[bB]ot|[bB]aiduspider|[oO][aA][iI]-[sS]earch[bB]ot|[cC]hat[gG][pP][tT]-[uU]ser|[gG][pP][tT][bB]ot|[pP]erplexity[bB]ot|[pP]erplexity-[uU]ser|[cC]laude[bB]ot|[cC]laude-[wW]eb|[aA]nthropic-[aA][iI]|[aA]pplebot|[fF]acebookexternalhit|[tT]elegram[bB]ot|[wW]hats[aA]pp|[tT]witter[bB]ot|[lL]inked[iI]n[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/seo?mode=html&ad=:adRef"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap-index\\.xml|sitemap-static\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com https://*.r2.cloudflarestorage.com https://*.r2.dev https://api.stripe.com https://www.google-analytics.com https://region1.google-analytics.com https://api.country.is; frame-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://checkout.stripe.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
